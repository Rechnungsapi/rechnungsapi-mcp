{
  "name": "rechnungsapi-mcp",
  "version": "0.4.0",
  "description": "Official MCP server for RechnungsAPI (rechnungsapi.de), the ZUGFeRD & XRechnung API: let AI agents create, validate and analyze e-invoices.",
  "license": "MIT",
  "author": {
    "name": "RechnungsAPI",
    "email": "support@rechnungsapi.de",
    "url": "https://rechnungsapi.de"
  },
  "homepage": "https://rechnungsapi.de/api-docs#mcp-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rechnungsapi/rechnungsapi-mcp.git"
  },
  "keywords": [
    "rechnungsapi",
    "rechnungsapi.de",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "zugferd",
    "xrechnung",
    "e-rechnung",
    "e-invoice",
    "e-invoicing",
    "en16931"
  ],
  "type": "module",
  "bin": {
    "rechnungsapi-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "rechnungsapi-sdk": "^0.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
